{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StoreHub",
  "version": "0.1.0",
  "identifier": "com.storehub.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm --prefix .. run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "publisher": "StoreHub",
    "copyright": "Copyright © StoreHub",
    "category": "Business",
    "shortDescription": "StoreHub store management desktop app",
    "longDescription": "StoreHub desktop app for managing your online stores, orders, products and POS from Windows.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English", "Arabic"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/rootsec26/StoreHub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
