# StoreHub desktop app environment.
# Copy to desktop/.env.local (git-ignored) and fill in your values.

# URL of the deployed StoreHub web app loaded inside the desktop window.
# Baked into the binary at build time; can also be overridden at runtime
# by setting STOREHUB_URL before launching the .exe.
STOREHUB_URL=https://your-storehub-domain.com

# Optional fallback used when STOREHUB_URL is unset.
# NEXT_PUBLIC_SITE_URL=https://your-storehub-domain.com
