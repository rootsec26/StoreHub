# ============================================
# Database (Supabase Postgres connection string)
# ============================================
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ============================================
# App session auth (JWT cookie signed by this app)
# ============================================
JWT_SECRET=change-me-to-a-long-random-string

# Super Admin panel (/admin + /api/admin/*) token.
# REQUIRED in production: admin surfaces fail closed (403/404) without it.
# Grant access with either:
#   - browser: open /admin?admin_token=<token> once (sets an httpOnly cookie)
#   - API    : x-admin-token: <token>  or  Authorization: Bearer <token>
# Local development without this variable stays open on localhost only.
ADMIN_TOKEN=

# Single email allowed to access /admin, /api/admin/* and /dashboard/*.
# Defaults to rootsec68@gmail.com when unset — set this to override per
# environment (e.g. a different email on Vercel vs local .env.local).
ADMIN_EMAIL=

# ============================================
# Supabase project (public values, safe for the browser)
# Project Settings -> API
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google OAuth (Supabase Auth) — optional. When enabled, add these redirect
# URLs in Supabase Dashboard → Authentication → URL Configuration:
#   http://localhost:3000/auth/callback
#   storehub://auth/callback          (Tauri desktop)
#   com.storehub.app://auth/callback  (Android)
#   https://<your-domain>/auth/callback
#
# Set to 1 to route native-shell OAuth through the web callback, which then
# bounces the raw code back into the app via the custom scheme (useful when a
# custom-scheme redirect URL cannot be allow-listed):
# NEXT_PUBLIC_OAUTH_TAURI_VIA_WEB=1
# NEXT_PUBLIC_OAUTH_ANDROID_VIA_WEB=1

# ============================================
# Supabase JWT Secret (server-only!)
# Project Settings -> API -> JWT Secret
#
# Used to mint short-lived `role=authenticated` tokens for:
#   - Supabase Storage uploads (RLS enforces the store_id/* folder path)
#   - Supabase Realtime subscriptions on the `orders` table
# Required for Phase 2 features. Never expose this value to the browser.
# ============================================
SUPABASE_JWT_SECRET=

# ============================================
# Stripe Payments (Phase 3 — Global Scale)
# Get keys from https://dashboard.stripe.com/apikeys
# ============================================
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# Paddle Payments (Phase 3 — Global Scale)
# Get API key from https://vendors.paddle.com/
# ============================================
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# ============================================
# OpenAI (optional — Phase 4 AI features)
# Powers the AI product description, marketing post
# and business insights generators (src/lib/ai.ts).
# When unset, these endpoints return mock Arabic
# responses so the UI keeps working in local/demo.
# Never expose this key to the browser.
# ============================================
OPENAI_API_KEY=
# Optional model override (defaults to gpt-4o-mini)
OPENAI_MODEL=

# ============================================
# Public site URL (Phase 5 SEO)
# Absolute origin used for metadataBase, canonical
# links, OpenGraph images, sitemap.xml and robots.txt.
# Examples: https://storehub.com  |  http://localhost:3000 (local dev only)
# ============================================
# Defaults to https://store-hub-beta.vercel.app when unset. Only override
# for local development or a custom production domain — never commit a
# localhost value to a deployed environment.
NEXT_PUBLIC_SITE_URL=https://store-hub-beta.vercel.app

# ============================================
# Store subdomains (Phase 5 routing)
# Apex domain that hosts stores as <slug>.<root-domain>,
# e.g. roboai.example.com -> NEXT_PUBLIC_ROOT_DOMAIN=example.com
# Leave empty to disable subdomain routing (slug routes only).
# ============================================
NEXT_PUBLIC_ROOT_DOMAIN=

# ============================================
# Extra image hosts allowed through the Next.js image
# optimizer (comma-separated). Supabase Storage is always
# allowed; owner-pasted URLs on other hosts render
# unoptimized instead of breaking.
# ============================================
NEXT_PUBLIC_IMAGE_ALLOWED_HOSTS=

# ============================================
# Smart COD Verification & Anti-Return Fraud Shield
# COD_RISK_AMOUNT_THRESHOLD  — order totals above this (EGP) are HIGH risk.
# COD_VERIFICATION_TTL_HOURS — pending WhatsApp confirmations that age out
#                              are flipped to EXPIRED on the orders page.
# ============================================
COD_RISK_AMOUNT_THRESHOLD=1500
COD_VERIFICATION_TTL_HOURS=24

# ============================================
# WhatsApp Cloud API (COD verification messages)
# When unset, the engine falls back to the short link
# https://[store].storehub.com/order/[id]/verify.
# WHATSAPP_API_URL   e.g. https://graph.facebook.com/v21.0/<PHONE_NUMBER_ID>/messages
# WHATSAPP_APP_SECRET validates X-Hub-Signature-256 on /api/webhooks/whatsapp
# WHATSAPP_VERIFY_TOKEN is echoed back on the webhook subscription handshake
# ============================================
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ============================================
# AI Social Selling & Conversational Checkout
# Powers /api/webhooks/social (Facebook / Instagram / WhatsApp).
# SOCIAL_WEBHOOK_VERIFY_TOKEN is echoed back on the subscription handshake.
# SOCIAL_APP_SECRET validates X-Hub-Signature-256. Required: unsigned
# payloads are rejected with 401 (e.g. set it to any value locally to
# simulate deliveries).
# SOCIAL_ENCRYPTION_KEY encrypts social_channels tokens (falls back to
# JWT_SECRET so a fresh environment works out of the box).
# META_GRAPH_API_VERSION defaults to v21.0 when unset.
# ============================================
SOCIAL_WEBHOOK_VERIFY_TOKEN=
SOCIAL_APP_SECRET=
SOCIAL_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=

# ============================================
# Carrier webhooks (/api/shipping/webhook)
# SHIPPING_WEBHOOK_SECRET signs `x-shipping-signature: sha256=<hmac>` for
# carrier status callbacks. Required unless the matching carrier integration
# in the dashboard holds an api_secret — with neither set, every delivery is
# rejected with 401 (fail closed) because DELIVERED also marks the order Paid.
# ============================================
SHIPPING_WEBHOOK_SECRET=

# Temporary free-growth mode flag (growth hacking period).
# true = all features free for everyone; remove/false to restore paid billing.
NEXT_PUBLIC_FREE_MODE=false

# ============================================
# Android app (Capacitor APK)
# Public URL of the latest StoreHub APK used by the
# "Download for Android" button on the landing page.
# Accepts a Supabase Storage public URL, a GitHub
# Release asset URL, or leave empty to serve the
# local file at /download/storehub.apk.
# Example: https://<project>.supabase.co/storage/v1/object/public/downloads/storehub.apk
# ============================================
NEXT_PUBLIC_ANDROID_APK_URL=

# Origin the Android app loads at runtime (Capacitor).
# Usually the same as NEXT_PUBLIC_SITE_URL.
# CAPACITOR_SERVER_URL=https://storehub.example.com
