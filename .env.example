# ============================================
# Database (Supabase Postgres connection string)
# ============================================
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ============================================
# App session auth (JWT cookie signed by this app)
# ============================================
JWT_SECRET=change-me-to-a-long-random-string

# ============================================
# Supabase project (public values, safe for the browser)
# Project Settings -> API
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ============================================
# Supabase JWT Secret (server-only!)
# Project Settings -> API -> JWT Secret
#
# Used to mint short-lived `role=authenticated` tokens for:
#   - Supabase Storage uploads (RLS enforces the store_id/* folder path)
#   - Supabase Realtime subscriptions on the `orders` table
# Required for Phase 2 features. Never expose this value to the browser.
# ============================================
SUPABASE_JWT_SECRET=

# ============================================
# Stripe Payments (Phase 3 — Global Scale)
# Get keys from https://dashboard.stripe.com/apikeys
# ============================================
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# Paddle Payments (Phase 3 — Global Scale)
# Get API key from https://vendors.paddle.com/
# ============================================
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# ============================================
# OpenAI (optional — Phase 4 AI features)
# Powers the AI product description, marketing post
# and business insights generators (src/lib/ai.ts).
# When unset, these endpoints return mock Arabic
# responses so the UI keeps working in local/demo.
# Never expose this key to the browser.
# ============================================
OPENAI_API_KEY=
# Optional model override (defaults to gpt-4o-mini)
OPENAI_MODEL=

# ============================================
# Public site URL (Phase 5 SEO)
# Absolute origin used for metadataBase, canonical
# links, OpenGraph images, sitemap.xml and robots.txt.
# Examples: https://storehub.com  |  http://localhost:3000
# ============================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# Store subdomains (Phase 5 routing)
# Apex domain that hosts stores as <slug>.<root-domain>,
# e.g. roboai.example.com -> NEXT_PUBLIC_ROOT_DOMAIN=example.com
# Leave empty to disable subdomain routing (slug routes only).
# ============================================
NEXT_PUBLIC_ROOT_DOMAIN=

# ============================================
# Extra image hosts allowed through the Next.js image
# optimizer (comma-separated). Supabase Storage is always
# allowed; owner-pasted URLs on other hosts render
# unoptimized instead of breaking.
# ============================================
NEXT_PUBLIC_IMAGE_ALLOWED_HOSTS=
